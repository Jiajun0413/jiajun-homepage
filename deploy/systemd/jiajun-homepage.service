[Unit]
Description=jiajun0805.cc.cd homepage (Dioxus SSR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/web
Environment=IP=127.0.0.1
Environment=PORT=8082
ExecStart=@ROOT@/web/dist/server
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
