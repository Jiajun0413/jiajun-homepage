[Unit]
Description=pdf2zh GUI (behind /translate)

[Service]
Type=simple
WorkingDirectory=/mnt/netshare2/liujiajun/pdf2zh-next
Environment=GRADIO_ROOT_PATH=/translate
Environment=GRADIO_ANALYTICS_ENABLED=False
Environment=BROWSER=/usr/bin/true
Environment=NO_PROXY=localhost,127.0.0.1,::1
Environment=no_proxy=localhost,127.0.0.1,::1
ExecStartPre=/usr/bin/grep -Eq '^[^,]+,[^,]+$' %h/.config/pdf2zh/access.csv
ExecStart=%h/.pixi/bin/pixi run --locked --manifest-path /mnt/netshare2/liujiajun/pdf2zh-next/pixi.toml python -I /mnt/netshare2/liujiajun/jiajun_homepage/deploy/pdf2zh_gui.py \
    --gui --disable-gui-sensitive-input --disable-config-auto-save \
    --config-file %h/.config/pdf2zh/config.v3.toml \
    --openaicompatible --term-openaicompatible --enabled-services OpenAICompatible \
    --auth-file %h/.config/pdf2zh/access.csv --ui-lang en
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target