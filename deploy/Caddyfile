pisd.cc.cd, www.pisd.cc.cd {
	tls /etc/caddy/certs/pisd.cc.cd.pem /etc/caddy/certs/pisd.cc.cd.key
	reverse_proxy 127.0.0.1:9000
	log
}

sbdssp.cc.cd, www.sbdssp.cc.cd {
	tls /etc/caddy/certs/sbdssp.cc.cd.pem /etc/caddy/certs/sbdssp.cc.cd.key
	encode
	reverse_proxy 127.0.0.1:8081
	log
}

jiajun0805.cc.cd, www.jiajun0805.cc.cd {
	tls /etc/caddy/certs/jiajun0805.cc.cd.pem /etc/caddy/certs/jiajun0805.cc.cd.key
	encode
	header X-Content-Type-Options nosniff
	@translation path /translate /translate/*
	header @translation Cache-Control "private, no-store"
	redir /translate /translate/ 308
	handle_path /translate/* {
		request_body {
			max_size 50MB
		}
		reverse_proxy unix//run/jiajun-homepage/translate.sock
	}
	handle {
		reverse_proxy unix//run/jiajun-homepage/site.sock
	}
	log
}
